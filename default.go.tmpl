{{/* ===== Inspection namespace ===== */}}
type {{$iface.InspectType}} struct{ m *{{$iface.MockName}} }

// {{$iface.InspectEntryName}} returns the inspection namespace — one method per
// interface method, each returning per-call records of {{$iface.Name}}.
func (this *{{$iface.MockName}}) {{$iface.InspectEntryName}}() {{$iface.InspectType}} {
	return {{$iface.InspectType}}{m: this}
}

// Reset clears every per-method call log on the mock without touching
// configured returns or installed handlers.
func (this {{$iface.InspectType}}) Reset() {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}{{range $method := $iface.Methods}}	this.m.{{$method.LogField}} = nil
{{end}}}

{{range $method := $iface.Methods}}func (this {{$iface.InspectType}}) {{$method.Name}}() {{$method.InspectMethodType}} {
	return {{$method.InspectMethodType}}{m: this.m}
}

{{end}}{{/* ===== Per-method inspection types ===== */}}
{{range $method := $iface.Methods}}type {{$method.InspectMethodType}} struct{ m *{{$iface.MockName}} }

// Count returns the number of recorded calls to {{$iface.Name}}.{{$method.Name}}.
func (this {{$method.InspectMethodType}}) Count() int {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	return len(this.m.{{$method.LogField}})
}

// At returns the i-th recorded call. Negative i counts from the end.
// Panics on out-of-range with a message that surfaces both the input
// and the log length.
func (this {{$method.InspectMethodType}}) At(i int) {{$method.CallType}} {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	return this.m.{{$method.LogField}}[this.m.callIndex(len(this.m.{{$method.LogField}}), i)]
}

// Last is sugar for At(-1).
func (this {{$method.InspectMethodType}}) Last() {{$method.CallType}} {
	return this.At(-1)
}

// All returns a defensive copy of the full call log.
func (this {{$method.InspectMethodType}}) All() []{{$method.CallType}} {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	out := make([]{{$method.CallType}}, len(this.m.{{$method.LogField}}))
	copy(out, this.m.{{$method.LogField}})
	return out
}

// Reset clears the call log for {{$method.Name}}.
func (this {{$method.InspectMethodType}}) Reset() {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	this.m.{{$method.LogField}} = nil
}

{{if $.Options.Async}}// WaitForCount blocks until at least n calls to {{$method.Name}} have been
// recorded, or until timeout elapses. Returns nil on success, an error
// describing the current count on timeout. Polls every 1ms.
func (this {{$method.InspectMethodType}}) WaitForCount(n int, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	for {
		if this.Count() >= n {
			return nil
		}
		if time.Now().After(deadline) {
			return errors.New("WaitForCount(" + strconv.Itoa(n) + ", " + timeout.String() + "): timed out, count = " + strconv.Itoa(this.Count()))
		}
		time.Sleep(time.Millisecond)
	}
}

// WaitForCall blocks until at least one recorded call to {{$method.Name}}
// satisfies the predicate, or until timeout elapses. Returns nil on
// success, an error on timeout. Polls every 1ms; on each poll, scans every
// recorded call from oldest to newest.
func (this {{$method.InspectMethodType}}) WaitForCall(predicate func({{$method.CallType}}) bool, timeout time.Duration) error {
	deadline := time.Now().Add(timeout)
	for {
		for _, c := range this.All() {
			if predicate(c) {
				return nil
			}
		}
		if time.Now().After(deadline) {
			return errors.New("WaitForCall(" + timeout.String() + "): timed out, no matching call in " + strconv.Itoa(this.Count()) + " recorded entries")
		}
		time.Sleep(time.Millisecond)
	}
}

