// AssertOrder calls t.Errorf when the given entries were not recorded in
// the given order. Adjacent entries with the same GlobalIndex (same call
// passed twice) are treated as in-order. 0 or 1 entries are a no-op.
func (this {{$iface.InspectType}}) AssertOrder(t {{$iface.MockName}}VerifyT, entries ...{{$iface.CallInterfaceType}}) {
	t.Helper()
	if len(entries) < 2 {
		return
	}
	prev := entries[0].Global()
	for i := 1; i < len(entries); i++ {
		cur := entries[i].Global()
		if cur < prev {
			t.Errorf("{{$iface.MockName}}: AssertOrder violated — entry " + strconv.Itoa(i) + " (global #" + strconv.Itoa(cur) + ") happened before entry " + strconv.Itoa(i-1) + " (global #" + strconv.Itoa(prev) + ")")
			return
		}
		prev = cur
	}
}

