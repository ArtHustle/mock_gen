{{end}}// mockCallAt returns log[i], treating negative i as an offset from the end.
// Out-of-range indices panic (slice semantics).
func mockCallAt[T any](log []T, i int) T {
	if i < 0 {
		i += len(log)
	}
	return log[i]
}

