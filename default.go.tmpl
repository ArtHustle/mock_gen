}

{{/* ===== Interface methods ===== */}}
{{range $method := $iface.Methods}}func (this *{{$iface.MockName}}) {{$method.Name}}({{$method.Signature.Params}}){{$method.Signature.Returns}} {
{{- if $method.ReturnFields}}
{{- if $.Options.Async}}
	this.mu.Lock()
{{end}}	this.{{$method.LogField}} = append(this.{{$method.LogField}}, {{$method.CallType}}{
		Index: len(this.{{$method.LogField}}),
		Param: {{$method.ParamType}}{ {{- range $i, $f := $method.ParamFields}}{{if $i}}, {{end}}{{$f.Name}}: {{index $method.Signature.ParamNames $i}}{{end}} },
	})
	__mockCallIdx := len(this.{{$method.LogField}}) - 1
	__mockHandler := this.{{$method.CfgField}}.{{$method.HandlerFieldName}}
{{range $i, $rf := $method.CfgReturnFields}}	__mockR{{$i}} := this.{{$method.CfgField}}.{{$rf.Name}}
{{end}}{{- if $.Options.Async}}	this.mu.Unlock()

{{end}}{{range $i, $rf := $method.ReturnFields}}	var __mockRet{{$i}} {{$rf.Type}}
{{end}}	if __mockHandler != nil {
		{{range $i, $rf := $method.ReturnFields}}{{if $i}}, {{end}}__mockRet{{$i}}{{end}} = __mockHandler({{range $i, $pn := $method.Signature.ParamNames}}{{if $i}}, {{end}}{{$pn}}{{end}})
	} else {
		{{range $i, $rf := $method.ReturnFields}}{{if $i}}, {{end}}__mockRet{{$i}}{{end}} = {{range $i, $rf := $method.ReturnFields}}{{if $i}}, {{end}}__mockR{{$i}}{{end}}
	}

{{if $.Options.Async}}	this.mu.Lock()
{{end}}	this.{{$method.LogField}}[__mockCallIdx].Return = {{$method.ReturnType}}{ {{- range $i, $rf := $method.ReturnFields}}{{if $i}}, {{end}}{{$rf.Name}}: __mockRet{{$i}}{{end}} }
{{- if $.Options.Async}}
	this.mu.Unlock()
{{end}}
	return {{range $i, $rf := $method.ReturnFields}}{{if $i}}, {{end}}__mockRet{{$i}}{{end}}
{{else}}
{{- if $.Options.Async}}
	this.mu.Lock()
	defer this.mu.Unlock()
{{end}}	this.{{$method.LogField}} = append(this.{{$method.LogField}}, {{$method.CallType}}{
		Index: len(this.{{$method.LogField}}),
		Param: {{$method.ParamType}}{ {{- range $i, $f := $method.ParamFields}}{{if $i}}, {{end}}{{$f.Name}}: {{index $method.Signature.ParamNames $i}}{{end}} },
	})
