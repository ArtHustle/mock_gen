func (this {{$method.ConfigMethodType}}) Always() {{$method.PerReturnSetterType}} {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	if this.m.{{$method.CfgField}}.stickySet || this.m.{{$method.CfgField}}.handlerSet {
		panic("{{$iface.MockName}}.{{$method.Name}}: cannot arm Once()/Always() while a sticky return is set; call .Reset() first")
	}
	this.m.{{$method.CfgField}}.alwaysStub = &{{$method.StubType}}{}
	return {{$method.PerReturnSetterType}}{m: this.m, target: this.m.{{$method.CfgField}}.alwaysStub}
}

{{end}}{{if $method.ReturnFields}}// When registers a conditional stub set whose entries fire only when
// the call's Param satisfies the predicate. Use Once()/Always() on the
// returned namespace to attach armings.
func (this {{$method.ConfigMethodType}}) When(pred func({{$method.ParamType}}) bool) {{$method.OnConditionalType}} {
{{- if $.Options.Async}}
	this.m.mu.Lock()
	defer this.m.mu.Unlock()
{{end}}	this.m.{{$method.CfgField}}.conditionals = append(
